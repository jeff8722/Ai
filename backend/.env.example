# Copy to backend/.env
# Leave blank to auto-find fashn-vton-1.5/weights inside or beside this project.
FASHN_VTON_WEIGHTS_DIR=
LOCAL_VTON_DEVICE=
LOCAL_VTON_CATEGORY=one-pieces
LOCAL_VTON_GARMENT_PHOTO_TYPE=flat-lay
LOCAL_VTON_STEPS=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Staff PIN for adding/removing catalogue products. Blank = admin open to anyone.
ADMIN_PIN=
